{% extends "layout.twig" %}

{% block content %}
    <section class="page-section login-section">

        <div class="page-title">
            <h1>Connexion client</h1>
            <p>Accédez à votre espace personnel.</p>
        </div>

        <form class="login-form" action="index.php?route=login" method="post">
                        <div class="form-group">
                <label for="email">Courriel</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="exemple@mail.com"
                    required
                >
            </div>

            <div class="form-group">
                <label for="password">Mot de passe</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Votre mot de passe"
                    required
                >
            </div>

            <button type="submit" class="btn btn-primary full-btn">
                Se connecter
            </button>

            <p class="form-link">
                Vous n'avez pas de compte ?
                <a href="index.php?route=register">Créer un compte</a>
            </p>

        </form>

    </section>
{% endblock %}