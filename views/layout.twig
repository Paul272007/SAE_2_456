<!DOCTYPE html>
<html lang="{{ session.language ?? "fr" }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site }} - {{ title }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="styles/style.css">
    <link rel="icon" type="image/png" href="../images/favicon.png">
    {% if stylesheet %}
        <link rel="stylesheet" href="{{ stylesheet }}">
    {% endif %}
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" href="index.php">
                    <img src="images/image.png" alt="Logo" width="150" height="50">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="index.php?route=home">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="index.php?route=lines">Lignes & Horaires</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="index.php?route=search">Recherche de Trajets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="index.php?route=about">A Propos</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="index.php?route=reservation/cart">
                                Panier 
                                {% if session.cart|length > 0 %}
                                    <span class="badge bg-primary">{{ session.cart|length }}</span>
                                {% endif %}
                            </a>
                        </li>
                        {% if connected %}
                            <li class="nav-item">
                                <a class="nav-link" href="index.php?route=user/dashboard">Mon Compte</a>
                            </li>
                            {% if isAdmin %}
                                <li class="nav-item">
                                    <a class="nav-link" href="index.php?route=admin/stats">Admin</a>
                                </li>
                            {% endif %}
                            <li class="nav-item">
                                <form action="index.php?route=user/logout" method="POST" class="d-inline">
                                    <button type="submit" class="nav-link text-danger btn btn-link" style="text-decoration: none;">Déconnexion</button>
                                </form>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="index.php?route=login">Connexion</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    {% if isAdmin %}
        <div class="bg-dark py-2 shadow-sm" style="border-bottom: 2px solid #cc0000;">
            <div class="container d-flex justify-content-center gap-4">
                <a href="index.php?route=user/dashboard" class="text-decoration-none py-1 {{ controllerName == 'Dashboard' and controllerFolder == 'User' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Dashboard' and controllerFolder == 'User' ? '#cc0000' : 'transparent' }};">Dashboard</a>
                <a href="index.php?route=admin/users" class="text-decoration-none py-1 {{ controllerName == 'Users' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Users' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Clients</a>
                <a href="index.php?route=admin/lines" class="text-decoration-none py-1 {{ controllerName == 'Lines' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Lines' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Lignes</a>
                <a href="index.php?route=admin/stats" class="text-decoration-none py-1 {{ controllerName == 'Stats' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Stats' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Statistiques</a>
            </div>
        </div>
    {% endif %}

    <main class="{{ title == 'Accueil' ? 'container-fluid p-0' : 'container mt-4' }}">
        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        {% if info %}
            <div class="alert alert-info">{{ info }}</div>
        {% endif %}

        {% if success %}
            <div class="alert alert-success">{{ success }}</div>
        {% endif %}

        {% if warning %}
            <div class="alert alert-warning">{{ warning }}</div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    <footer class="viking-footer mt-5">
    <div class="container text-center text-md-start">
        <div class="row text-center text-md-start">
            
            <div class="col-md-4 col-lg-4 col-xl-4 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold footer-heading">{{ site }}</h5>
                <p>
                    Votre réseau de cars normands reliant toutes les communes de la région. 
                    Voyagez en toute sérénité, cumulez des points et profitez de nos réductions !
                    Pour moins de retard sur nos lignes de bus nous ajoutons l'heure en direct !
                </p>
            </div>

            <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold footer-heading">Liens rapides</h5>
                <p><a href="index.php?route=lines" class="footer-link">Nos Lignes</a></p>
                <p><a href="index.php?route=reservation" class="footer-link">Réserver un trajet</a></p>
                <p><a href="index.php?route=about" class="footer-link">À propos</a></p>
            </div>

            <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold footer-heading">Contact</h5>
                <p>Campus 3, 14123 Ifs, Normandie</p>
                <p>contact@viking-transport.fr</p>
                <p>+33 2 31 00 67 28</p>
            </div>
            
        </div>

        <hr class="mb-4 footer-divider">

        <div class="row align-items-center">
            <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                <img src="images/image.png" alt="Viking Transport Logo" width="150" height="50" class="footer-logo">
            </div>
            
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <p class="mb-0 copyright-text">&copy; 2026 {{ site }}. Tous droits réservés.</p>
            </div>
            
            <div class="col-md-4 text-center text-md-end">
                <p id="horloge" class="horloge-style mb-0"></p>
            </div>
        </div>
    </div>
</footer>

    <script src="scripts/layout.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmxc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% if javascript %}
        <script src="{{ javascript }}"></script>
    {% endif %}
</body>

</html>