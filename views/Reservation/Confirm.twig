{% extends "layout.twig" %}

{% block content %}
<h1>Confirmation de réservation</h1>

<div class="confirm-card">
    <h2>Récapitulatif</h2>

    <table class="recap-table">
        <tr>
            <th>Trajets</th>
            <td>
                <ul>
                    {% for item in cart %}
                        <li>{{ item.ligne_nom }} ({{ item.nom_depart }} → {{ item.nom_arrivee }} le {{ item.date|date('d/m/Y') }})</li>
                    {% endfor %}
                </ul>
            </td>
        </tr>
        <tr>
            <th>Distance totale</th>
            <td>{{ total_distance|round(2) }} km</td>
        </tr>
        <tr>
            <th>Points de fidélité gagnés</th>
            <td>+ {{ total_points_earned }} points</td>
        </tr>
        <tr class="total-row">
            <th>Prix total</th>
            <td><strong>{{ total_price|number_format(2, ',', ' ') }} €</strong></td>
        </tr>
    </table>
</div>

{% if connected %}
    {# Utilisateur connecté : proposition de paiement/confirmation #}
    <div class="payment-section">
        <h2>Paiement</h2>
        <p>En cliquant sur "Confirmer et payer", vous validez votre réservation.</p>

        <form action="index.php?route=reservation/confirm" method="POST" id="confirmForm">
                        
            {% if points_available > 0 and points_to_use > 0 %}
                <div class="points-section" style="margin-bottom: 15px; padding: 10px; background: #f8f9fa; border-radius: 5px;">
                    <p>Vous avez <strong>{{ points_available }} points</strong> de fidélité disponibles.</p>
                    <label>
                        <input type="checkbox" name="use_points" value="yes" id="usePointsCheckbox">
                        Utiliser {{ points_to_use }} points pour une réduction de {{ points_discount_value|number_format(2, ',', ' ') }} €
                    </label>
                </div>
            {% endif %}

            <button type="submit" class="btn btn-success" id="btnConfirm">
                ✓ Confirmer et payer (<span id="finalPrice">{{ total_price|number_format(2, ',', ' ') }}</span> €)
            </button>
        </form>

        <a href="index.php?route=reservation/cart" class="btn btn-secondary mt-3">← Retour au panier</a>
    </div>

    {% if points_available > 0 and points_to_use > 0 %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkbox = document.getElementById('usePointsCheckbox');
            const priceSpan = document.getElementById('finalPrice');
            const originalPrice = {{ total_price|number_format(2, '.', '') }};
            const discount = {{ points_discount_value|number_format(2, '.', '') }};

            checkbox.addEventListener('change', function() {
                let currentPrice = originalPrice;
                if (this.checked) {
                    currentPrice -= discount;
                }
                // Format to French locale
                priceSpan.textContent = currentPrice.toFixed(2).replace('.', ',');
            });
        });
    </script>
    {% endif %}
{% else %}
    {# Client non inscrit : possibilité de payer ou invitation à se connecter #}
    <div class="payment-section">
        <h2>Paiement</h2>
        
        <div class="alert alert-secondary shadow-sm">
            <h5 class="alert-heading">Programme de fidélité</h5>
            <p class="mb-0">
                Saviez-vous que ce trajet vous rapporte <strong>{{ total_points_earned }} points</strong> ?<br>
                <a href="index.php?route=login" class="fw-bold">Connectez-vous</a> ou <a href="index.php?route=register" class="fw-bold">créez un compte</a> dès maintenant pour les cumuler et profiter de réductions sur vos prochains trajets !
            </p>
        </div>

        <p class="text-muted">Ou continuez sans compte :</p>
        <form action="index.php?route=reservation/confirm" method="POST" id="confirmForm">
            <button type="submit" class="btn btn-success btn-lg px-4" id="btnConfirm">
                ✓ Payer en tant qu'invité ({{ total_price|number_format(2, ',', ' ') }} €)
            </button>
        </form>

        <div class="mt-4">
            <a href="index.php?route=reservation/cart" class="btn btn-outline-secondary">← Retour au panier</a>
        </div>
    </div>
{% endif %}
{% endblock %}
