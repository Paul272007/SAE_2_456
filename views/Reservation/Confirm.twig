{% extends "layout.twig" %}

{% block content %}
<h1>Confirmation de réservation</h1>

<div class="confirm-card">
    <h2>Récapitulatif</h2>

    <table class="recap-table">
        <tr>
            <th>Ligne</th>
            <td>{{ reservation.ligne_nom }}</td>
        </tr>
        <tr>
            <th>Départ</th>
            <td>{{ reservation.nom_depart }}</td>
        </tr>
        <tr>
            <th>Arrivée</th>
            <td>{{ reservation.nom_arrivee }}</td>
        </tr>
        <tr>
            <th>Date</th>
            <td>{{ reservation.date }}</td>
        </tr>
        <tr>
            <th>Distance</th>
            <td>{{ reservation.distance|round(2) }} km</td>
        </tr>
        <tr>
            <th>Points de fidélité gagnés</th>
            <td>+ {{ reservation.nb_points }} points</td>
        </tr>
        <tr class="total-row">
            <th>Prix total</th>
            <td><strong>{{ reservation.prix_total|number_format(2, ',', ' ') }} €</strong></td>
        </tr>
    </table>
</div>

{% if connected %}
    {# Utilisateur connecté : proposition de paiement/confirmation #}
    <div class="payment-section">
        <h2>Paiement</h2>
        <p>En cliquant sur "Confirmer et payer", vous validez votre réservation.</p>

        <form action="index.php?route=reservation/confirm" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="btn-confirm">✓ Confirmer et payer ({{ reservation.prix_total|number_format(2, ',', ' ') }} €)</button>
        </form>

        <a href="index.php?route=reservation&lig_num={{ reservation.lig_num }}" class="btn-back">← Modifier ma réservation</a>
    </div>
{% else %}
    {# Client non inscrit : invitation à se connecter ou créer un compte #}
    <div class="guest-section">
        <p class="info-box">
            ⚠️ Votre réservation est bien calculée. Pour la finaliser, vous devez avoir un compte.
            <br>Vos données seront conservées pendant la création de votre compte.
        </p>
        <div class="guest-actions">
            <a href="index.php?route=login" class="btn-primary">Se connecter</a>
            <a href="index.php?route=register" class="btn-secondary">Créer un compte</a>
        </div>
        <a href="index.php?route=reservation&lig_num={{ reservation.lig_num }}" class="btn-back">← Modifier ma réservation</a>
    </div>
{% endif %}
{% endblock %}
