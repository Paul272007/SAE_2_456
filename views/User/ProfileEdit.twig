{% extends "layout.twig" %}

{% block content %}
<h1>Modifier mon profil</h1>

<a href="index.php?route=user/dashboard" class="btn-back">← Retour au tableau de bord</a>

<div class="dashboard-grid" style="margin-top: 20px;">
    <!-- Modifier les infos -->
    <div class="card">
        <h2>Mes Informations</h2>
        <form action="index.php?route=user/profile/edit" method="POST">
                        <input type="hidden" name="update_info" value="1">
            
            <div class="form-group">
                <label for="cli_nom">Nom</label>
                <input type="text" id="cli_nom" name="cli_nom" value="{{ user.cli_nom }}" required>
            </div>
            
            <div class="form-group">
                <label for="cli_prenom">Prénom</label>
                <input type="text" id="cli_prenom" name="cli_prenom" value="{{ user.cli_prenom }}" required>
            </div>
            
            <div class="form-group">
                <label for="cli_ville">Ville</label>
                <input type="text" id="cli_ville" name="cli_ville" value="{{ user.cli_ville }}" required>
            </div>
            
            <div class="form-group">
                <label for="cli_telephone">Téléphone</label>
                <input type="text" id="cli_telephone" name="cli_telephone" value="{{ user.cli_telephone }}" required>
            </div>
            
            <button type="submit" class="btn-primary">Enregistrer les modifications</button>
        </form>
    </div>

    <!-- Modifier le mot de passe -->
    <div class="card">
        <h2>Mot de passe</h2>
        <form action="index.php?route=user/profile/edit" method="POST">
                        <input type="hidden" name="update_password" value="1">
            
            <div class="form-group">
                <label for="current_password">Mot de passe actuel</label>
                <input type="password" id="current_password" name="current_password" required>
            </div>
            
            <div class="form-group">
                <label for="new_password">Nouveau mot de passe</label>
                <input type="password" id="new_password" name="new_password" required minlength="8">
            </div>
            
            <div class="form-group">
                <label for="confirm_password">Confirmer le nouveau mot de passe</label>
                <input type="password" id="confirm_password" name="confirm_password" required minlength="8">
            </div>
            
            <button type="submit" class="btn-primary">Mettre à jour le mot de passe</button>
        </form>
    </div>
</div>
{% endblock %}
