{% extends "layout.twig" %}

{% block content %}

    <h1>{{ lang('settings') }}</h1>
    <form action="index.php?route=user/settings" method="POST">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label>
            {{ lang('language') }}
            <select name="language">
                {% for l in language_options %}
                    <option value="{{ l }}" {{ l == language ? 'selected' }}>{{ lang(l) }}</option>
                {% endfor %}
            </select>
        </label>
        <button type="submit">{{ lang('change_settings') }}</button>
    </form>

{% endblock %}
