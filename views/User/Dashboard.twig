{% extends "layout.twig" %}

{% block content %}

<link rel="stylesheet" href="styles/Dashboard.css">

{% set isOr = user.typ_nom|lower == 'or' %}

{% if isOr %}

{% if isAdmin %}
    <div class="bg-dark py-2 shadow-sm" style="border-bottom: 2px solid #cc0000;">
        <div class="container d-flex justify-content-center gap-4">
            <a href="index.php?route=user/dashboard" class="text-decoration-none py-1 {{ controllerName == 'Dashboard' and controllerFolder == 'User' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Dashboard' and controllerFolder == 'User' ? '#cc0000' : 'transparent' }};">Dashboard</a>
            <a href="index.php?route=admin/users" class="text-decoration-none py-1 {{ controllerName == 'Users' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Users' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Clients</a>
            <a href="index.php?route=admin/lines" class="text-decoration-none py-1 {{ controllerName == 'Lines' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Lines' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Lignes</a>
            <a href="index.php?route=admin/stats" class="text-decoration-none py-1 {{ controllerName == 'Stats' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Stats' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Statistiques</a>
        </div>
    </div>
{% endif %}

<script>document.body.classList.add('grade-or');</script>

<!-- Bandeau Or -->
<div class="or-crown-bar">✦ Membre Or — Accès Privilégié ✦</div>

<section class="page-section">

    <!-- Header -->
    <div class="or-header d-flex justify-content-between align-items-start">
        <div>
            <h1>Tableau de bord — <span class="accent">{{ username }}</span></h1>
            <div class="or-badge">✦ Grade Or</div>
        </div>
        <form action="index.php?route=user/logout" method="POST">
            <button type="submit" class="btn-or-outline">Se déconnecter</button>
        </form>
    </div>

    <div class="row mb-4 g-3">

        <!-- Profil -->
        <div class="col-md-4">
            <div class="or-card">
                <h3>Mes informations</h3>
                <p><strong>Statut :</strong> <span class="or-badge or-badge-sm">✦ Or</span></p>
                <p><strong>Nom :</strong> {{ user.cli_prenom }} {{ user.cli_nom }}</p>
                <p><strong>Email :</strong> {{ user.cli_courriel }}</p>
                <p><strong>Téléphone :</strong> {{ user.cli_telephone }}</p>
                <p><strong>Ville :</strong> {{ user.cli_ville }}</p>
                <div class="mt-4">
                    <a href="index.php?route=user/profileEdit" class="btn-or">Modifier mon profil</a>
                </div>
            </div>
        </div>

        <!-- Points fidélité -->
        <div class="col-md-4">
            <div class="or-card text-center">
                <h3>Programme de fidélité</h3>
                <div class="or-points-big">{{ user.cli_nb_points_ec }}</div>
                <div class="or-points-label">points disponibles</div>
                <hr class="or-divider">
                <p class="or-points-hint">Total gagné depuis l'inscription</p>
                <p class="or-points-total">{{ user.cli_nb_points_tot }}</p>
                <p class="or-points-hint">10 pts = 1 € de réduction</p>
            </div>
        </div>

        <!-- Avantages Or -->
        <div class="col-md-4">
            <div class="or-card">
                <h3>Votre (seul) avantage exclusif</h3>
                <div class="or-avantage">
                    <div class="or-avantage-icon">%</div>
                    <div class="or-avantage-text">
                        <strong>Réduction maximale</strong>
                        Bénéficiez du taux de réduction le plus élevé sur tous vos trajets.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Réservations -->
    <div class="or-card">
        <h3>Mes réservations</h3>
        {% if reservations is empty %}
            <div class="text-center py-4">
                <p class="or-empty">Aucune réservation pour le moment.</p>
                <a href="index.php?route=lines" class="btn-or">Réserver un trajet</a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="or-table">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Date</th>
                            <th>Trajet(s)</th>
                            <th>Prix</th>
                            <th>Points gagnés</th>
                            <th>Points dépensés</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for res in reservations %}
                        <tr>
                            <td><strong>#{{ res.res_num }}</strong></td>
                                    <td>{{ res.res_date|date("d/m/Y") }}</td>
                                    <td>{{ res.trajets }}</td>
                                    <td><strong>{{ res.res_prix_tot|number_format(2, ',', ' ') }} €</strong></td>
                                    <td style="color: #00cc22;"><strong>+{{ res.res_nb_points }}</strong></td>
                                    <td style="color: #cc0000;">
                                    <strong>-{{ res.res_nb_points_dep }}</strong>
                                    </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

</section>

{% else %}

{# ── Dashboard standard (inchangé) ── #}

{% if isAdmin %}
    <div class="bg-dark py-2 shadow-sm" style="border-bottom: 2px solid #cc0000;">
        <div class="container d-flex justify-content-center gap-4">
            <a href="index.php?route=user/dashboard" class="text-decoration-none py-1 {{ controllerName == 'Dashboard' and controllerFolder == 'User' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Dashboard' and controllerFolder == 'User' ? '#cc0000' : 'transparent' }};">Dashboard</a>
            <a href="index.php?route=admin/users" class="text-decoration-none py-1 {{ controllerName == 'Users' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Users' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Clients</a>
            <a href="index.php?route=admin/lines" class="text-decoration-none py-1 {{ controllerName == 'Lines' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Lines' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Lignes</a>
            <a href="index.php?route=admin/stats" class="text-decoration-none py-1 {{ controllerName == 'Stats' and controllerFolder == 'Admin' ? 'text-white fw-bold' : 'text-secondary' }}" style="border-bottom: 2px solid {{ controllerName == 'Stats' and controllerFolder == 'Admin' ? '#cc0000' : 'transparent' }};">Statistiques</a>
        </div>
    </div>
{% endif %}

<section class="page-section">

    <div class="d-flex justify-content-between align-items-center mb-4 page-title">
        <div>
            <h1>Tableau de bord</h1>
            <p>Bienvenue, <span class="home-accent">{{ username }}</span></p>
        </div>
        <form action="index.php?route=user/logout" method="POST">
            <button type="submit" class="btn btn-outline-danger">Se déconnecter</button>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-4 mb-md-0">
            <div class="summary-box h-100 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-4">Mes Informations</h3>
                    <p>
                        <strong>Statut Client :</strong> 
                        {% set badgeColor = '#6c757d' %}
                        {% set textColor = 'text-white' %}
                        {% if user.typ_nom|lower == 'nouveau' %}
                            {% set badgeColor = '#0dcaf0' %}
                            {% set textColor = 'text-dark' %}
                        {% elseif user.typ_nom|lower == 'poussin' %}
                            {% set badgeColor = '#ffc107' %}
                            {% set textColor = 'text-dark' %}
                        {% elseif user.typ_nom|lower == 'junior' %}
                            {% set badgeColor = '#20c997' %}
                            {% set textColor = 'text-white' %}
                        {% elseif user.typ_nom|lower == 'bronze' %}
                            {% set badgeColor = '#cd7f32' %}
                            {% set textColor = 'text-white' %}
                        {% elseif user.typ_nom|lower == 'argent' %}
                            {% set badgeColor = '#c0c0c0' %}
                            {% set textColor = 'text-dark' %}
                        {% elseif user.typ_nom|lower == 'or' %}
                            {% set badgeColor = '#ffd700' %}
                            {% set textColor = 'text-dark' %}
                        {% elseif user.typ_nom|lower == 'platine' %}
                            {% set badgeColor = '#e5e4e2' %}
                            {% set textColor = 'text-dark' %}
                        {% endif %}
                        
                        {% if not user.typ_nom %}
                            <span class="badge bg-secondary">Aucun</span>
                        {% else %}
                            <span class="badge {{ textColor }}" style="background-color: {{ badgeColor }};">{{ user.typ_nom }}</span>
                        {% endif %}
                    </p>
                    <p><strong>Nom :</strong> {{ user.cli_prenom }} {{ user.cli_nom }}</p>
                    <p><strong>Email :</strong> {{ user.cli_courriel }}</p>
                    <p><strong>Téléphone :</strong> {{ user.cli_telephone }}</p>
                    <p><strong>Ville :</strong> {{ user.cli_ville }}</p>
                    <div class="mt-4">
                        <a href="index.php?route=user/profileEdit" class="btn btn-dark">Modifier mon profil</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="summary-box h-100 shadow-sm border-0" style="background-color: #fcebeb;">
                <div class="card-body">
                    <h3 class="mb-4" style="color: #cc0000;">Programme de Fidélité</h3>
                    <div class="text-center mb-3">
                        <span class="display-4 fw-bold" style="color: #cc0000;">{{ user.cli_nb_points_ec }}</span>
                        <p class="text-muted text-uppercase fw-bold" style="letter-spacing: 0.1em; font-size: 0.9rem;">points disponibles</p>
                    </div>
                    <hr>
                    <p class="mb-1 text-center"><em>Total des points gagnés : {{ user.cli_nb_points_tot }}</em></p>
                    <p class="text-center small text-muted">10 points = 1€ de réduction sur vos prochains trajets !</p>
                </div>
            </div>
        </div>
    </div>

    <div class="summary-box shadow-sm border-0">
        <div class="card-body">
            <h3 class="mb-4">Mes Réservations</h3>
            {% if reservations is empty %}
                <div class="text-center py-4">
                    <p class="text-muted mb-3">Vous n'avez pas encore effectué de réservation.</p>
                    <a href="index.php?route=lines" class="btn btn-danger">Réserver un trajet</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Date</th>
                                <th>Trajet(s)</th>
                                <th>Prix</th>
                                <th>Points gagnés</th>
                                <th>Points dépensés</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for res in reservations %}
                                <tr>
                                    <td><strong>#{{ res.res_num }}</strong></td>
                                    <td>{{ res.res_date|date("d/m/Y") }}</td>
                                    <td>{{ res.trajets }}</td>
                                    <td><strong>{{ res.res_prix_tot|number_format(2, ',', ' ') }} €</strong></td>
                                    <td style="color: #00cc22;"><strong>+{{ res.res_nb_points }}</strong></td>
                                    <td style="color: #cc0000;">
                                    <strong>-{{ res.res_nb_points_dep }}</strong>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>

</section>

{% endif %}

{% endblock %}
