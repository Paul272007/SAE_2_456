{% extends "layout.twig" %}

{% block content %}
<section class="page-section">
    <div class="page-title">
        <h1>Lignes de Transport</h1>
        <p>Consultez toutes nos lignes, leurs horaires et réservez votre prochain trajet.</p>
    </div>

    {% if lines is empty %}
        <div class="alert alert-info">Aucune ligne disponible pour le moment.</div>
    {% else %}
        <div class="line-accordion-list">
            {% for line in lines %}
                <div class="line-accordion-item">
                    <div class="line-accordion-header" onclick="this.parentElement.classList.toggle('open')">
                        <div class="line-accordion-header-left">
                            <span class="line-badge">{{ line.lig_num }}</span>
                            <span>{{ line.commune_depart }} → {{ line.commune_arrivee }}</span>
                        </div>
                        <div>
                            <span class="text-muted me-3 d-none d-md-inline">{{ line.nb_arrets }} arrêts • {{ line.distance_totale|round(1) }} km</span>
                            <span class="arrow-icon">▼</span>
                        </div>
                    </div>
                    
                    <div class="line-accordion-body">
                        <div class="d-flex justify-content-end mb-3 mt-2">
                            <a href="index.php?route=reservation&lig_num={{ line.lig_num }}" class="btn btn-primary btn-sm">
                                Réserver sur cette ligne
                            </a>
                        </div>
                        <div class="table-responsive">
                            <table class="schedule-table">
                                <thead>
                                    <tr>
                                        <th>Arrêt</th>
                                        <th>Heure de passage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for stop in line.stops %}
                                        <tr>
                                            <td><strong>{{ stop.arret_nom }}</strong></td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-2">
                                                    {% for heure in stop.heures %}
                                                        <span class="badge bg-light text-dark border p-2" style="font-size: 0.85rem; font-weight: 500;">
                                                            <i class="bi bi-clock me-1 text-muted"></i>{{ heure }}
                                                        </span>
                                                    {% endfor %}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
