{% extends "layout.twig" %}

{% block content %}
<h1>Lignes de transport</h1>

{% if lines is empty %}
    <p>Aucune ligne disponible pour le moment.</p>
{% else %}
    <ul class="lines-list">
        {% for line in lines %}
            {%include "Components/Line.twig" with {
                line_number_ line.lig_num,
                line_terminus_1: line.commune_depart,
                line_terminus_2: line. commune_arrovée,
                sops:[]
            }%}
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}