{% extends "layout.twig" %}

{% block content %}
<h1>Lignes de transport</h1>

{% if lines is empty %}
    <p>Aucune ligne disponible pour le moment.</p>
{% else %}
    <ul class="d-flex flex-column gap-3">
        {% for line in lines %}
            {%include "Components/Line.twig" with {
                line_number: line.LIG_NUM,
                line_terminus_1: line.COMMUNE_DEPART,
                line_terminus_2: line.COMMUNE_ARRIVEE,
                stops: line.stops,
            }%}
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}